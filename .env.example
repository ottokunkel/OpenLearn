# Redis
REDIS_URL=redis://localhost:6379/0
INPUT_QUEUE=docling:jobs

# S3-compatible storage
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_OUTPUT_BUCKET=docling-output

# VLM configuration
OPENROUTER_API_KEY=sk-or-v1-...
VLM_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Worker behavior
DOWNLOAD_DIR=/tmp/pdf_downloads
DOCUMENT_TIMEOUT_SECONDS=120
VLM_MAX_TOKENS=8192
VLM_CONCURRENCY=50
CHUNK_BATCH_SIZE=100

# Embedding (optional — leave EMBEDDING_API_KEY empty to disable)
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# Supabase / Postgres (set DATABASE_URL to enable pgmq mode, replacing Redis)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
#
# When using Supabase Storage, point S3 settings at Supabase:
# S3_ENDPOINT_URL=https://[project-ref].supabase.co/storage/v1/s3
# S3_ACCESS_KEY=<from Supabase Storage S3 settings>
# S3_SECRET_KEY=<from Supabase Storage S3 settings>
