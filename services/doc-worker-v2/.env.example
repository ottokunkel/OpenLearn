# ---------------------------------------------------------------
# doc-worker-v2 configuration
# Every key maps to a field on doc_worker_v2.config.Settings.
# Required keys vary by selected backend / pipeline (see validator).
# ---------------------------------------------------------------

# --- Backend selection (supabase|postgres) ----------------------
QUEUE_BACKEND=supabase               # which Queue impl to build
DOCUMENT_STORE_BACKEND=supabase      # which DocumentStore impl to build
BLOB_STORE_BACKEND=supabase          # which BlobStore impl to build

# --- Pipeline selection -----------------------------------------
# granite_docling_vlm | generic_markdown_vlm | standard_cpu
PIPELINE=granite_docling_vlm

# --- Supabase (required when any *_BACKEND=supabase) ------------
SUPABASE_URL=https://<project>.supabase.co   # Supabase project URL
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...      # service-role key (bypasses RLS)
SUPABASE_STORAGE_BUCKET=documents            # bucket holding uploaded PDFs + artifacts

# --- Generic Postgres (required when any *_BACKEND=postgres) ----
POSTGRES_DSN=                        # e.g. postgres://user:pass@host:5432/db

# --- VLM (required for VLM pipelines) ---------------------------
VLM_ENDPOINT_URL=https://<modal-app>/v1/chat/completions  # OpenAI-compatible chat-completions URL
VLM_MODEL_NAME=ibm-granite/granite-docling-258M           # model id served by the endpoint
VLM_PRESET=granite_docling                                 # docling preset (generic_markdown_vlm only)
VLM_TIMEOUT_S=600                                          # per-request HTTP timeout

# --- Worker tuning ----------------------------------------------
POLL_INTERVAL_S=5                    # sleep between empty-queue polls
VISIBILITY_TIMEOUT_S=300             # must exceed P99 job duration
BATCH_SIZE=1                         # messages read per poll
MAX_RETRIES=3                        # attempts before archive to dead-letter
LOG_LEVEL=INFO                       # python log level
